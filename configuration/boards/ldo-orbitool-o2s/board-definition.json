{
	"$schema": "../board-definition.schema.json",
	"isToolboard": true,
	"name": "Orbitool O2s",
	"manufacturer": "LDO",
	"id": "ldo-orbitool-o2s",
	"firmwareBinaryName": "firmware-ldo-orbitool-o2s.bin",
	"boardImageFileName": "board.webp",
	"compileScript": "compile.sh",
	"thermistorPullup": 2200,
	"flashScript": "flash.sh",
	"documentationLink": "https://os.ratrig.com/docs/boards/ldo/orbitool-o2",
	"disableAutoFlash": false,
	"driverVoltages": [24],
	"hasMcuTempSensor": true,
	"invertPinLogic": ["PB0","PB15"],
	"driverCount": 1,
	"integratedDrivers": {
		"extruder": "LDO-2240-UART"
	},
	"dfu": {
		"flashDevice": "0483:df11",
		"dfuBootImage": "dfubooting.webp",
		"instructions": [
			"Connect the board via USB to the Raspberry Pi",
			"Make sure the board is powered (you can use usb power by placing a jumper on the VBUS pins)",
			"Press and hold the BOOT button on the board.",
			"Press and release the RESET button on the board.",
			"Release the BOOT button."
		],
		"hasBoot0Jumper": false
	},
	"ADXL345SPI": {
		"cs_pin": "PA4",
		"hardware": {
			"bus": "spi1"
		}
	},
	"customSections": {
		"extruder": {
			"parameters": {
				"max_power": 0.995
			}
		},
		"adc_temperature": {
			"name": "hotend_power_scale",
			"parameters": {
				"temperature1": 0,
				"voltage1": 0,
				"temperature2": 119,
				"voltage2": 1.91,
				"temperature3": 239,
				"voltage3": 3.82
			}
		},
		"fan": {
			"parameters": {
				"max_power": 1,
				"enable_pin": "PB14",
				"shutdown_speed": 0,
				"tachometer_pin": "PA14",
				"tachometer_ppr": 2,
				"tachometer_poll_interval": 0.00005
			}
		},
		"heater_fan": {
			"name": "toolhead_cooling_fan",
			"parameters": {
				"max_power": 1,
				"cycle_time": 0.0001,
				"shutdown_speed": 0,
				"tachometer_pin": "PB12",
				"tachometer_ppr": 2,
				"tachometer_poll_interval": 0.00005
			}
		},
		"output_pin": {
			"name": "O2_RUN_LED",
			"parameters": {
				"pin": "PB13",
				"shutdown_value": 0,
				"value": 1
			}
		},
		"temperature_sensor": {
			"name": "hotend_power_draw",
			"parameters": {
				"sensor_pin": "PA0",
				"sensor_type": "hotend_power_scale"
			}
		}
	}
}
